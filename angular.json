{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "yarn"
	},
	"newProjectRoot": "projects",
	"projects": {
		"my__portfolio--angular-v22": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"changeDetection": "OnPush",
					"style": "scss",
					"skipTests": true,
					"standalone": true
				},
				"@schematics/angular:directive": {
					"skipTests": true,
					"standalone": true
				},
				"@schematics/angular:pipe": {
					"skipTests": true,
					"standalone": true
				}
			},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"outputPath": "dist",
						"index": "src/index.html",
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"security": {
							"allowedHosts": [
								"serhii.com.pl",
								"serhii-deineko.web.app",
								"serhii-deineko.firebaseapp.com",
								"localhost"
							]
						},
						"inlineStyleLanguage": "scss",
						"stylePreprocessorOptions": {
							"includePaths": [
								"src/styles"
							]
						},
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							},
							"src/assets",
							"src/robots.txt",
							"src/humans.txt"
						],
						"styles": [
							"@angular/material/prebuilt-themes/azure-blue.css",
							"src/styles.scss"
						],
						"scripts": []
					},
					"configurations": {
						"production": {
							"optimization": true,
							"outputHashing": "all",
							"sourceMap": false,
							"namedChunks": false,
							"aot": true,
							"extractLicenses": true,
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "1.5mb",
									"maximumError": "2mb"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "10kb",
									"maximumError": "15kb"
								}
							],
							"server": "src/main.server.ts",
							"outputMode": "static"
						},
						"development": {
							"optimization": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "my__portfolio--angular-v22:build:production"
						},
						"development": {
							"buildTarget": "my__portfolio--angular-v22:build:development"
						}
					},
					"defaultConfiguration": "development",
					"options": {
						"host": "localhost",
						"port": 4200
					}
				},
				"test": {
					"builder": "@angular/build:unit-test",
					"options": {
						"tsConfig": "tsconfig.spec.json",
						"runner": "vitest"
					}
				}
			}
		}
	}
}
